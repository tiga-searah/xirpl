{
  "name": "@xirpl/api",
  "module": "src/index.ts",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --minify-whitespace --minify-syntax --target bun --external sharp --outdir dist",
    "start": "PORT=3611 bun dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@elysia/bearer": "^1.4.4",
    "@elysia/cors": "^1.4.2",
    "@elysia/jwt": "^1.4.2",
    "@elysia/openapi": "^1.4.15",
    "@xirpl/db": "workspace:*",
    "@xirpl/shared": "workspace:*",
    "better-elysia-oauth2": "^1.0.0",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.3",
    "svg-for-pdfkit": "^0.2.1",
    "web-push": "^3.6.7"
  }
}
