{
  "name": "xirpl",
  "version": "2.0.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "scripts": {
    "dev": "turbo dev --ui=tui --filter=!@xirpl/ocr",
    "dev:full": "turbo dev --ui=tui",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:admin": "bun run --cwd apps/admin dev",
    "dev:ocr": "bun run --cwd services/ocr dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo clean",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:push": "bun run --cwd packages/db db:push",
    "db:pull": "bun run --cwd packages/db db:pull",
    "db:seed": "bun run --cwd packages/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "apps/**",
    "!apps/web/.next/**",
    "!apps/admin/.next/**",
    "packages/**",
    "services/**"
  ],
  "overrides": {
    "elysia": "1.4.29"
  },
  "resolutions": {
    "elysia": "1.4.29"
  }
}
